# copy this to .env and put your own values in
# (.env is ignored by git so the password never ends up on github)

# any long random string works, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

DB_HOST=localhost
DB_PORT=3306
DB_NAME=housing_aggregator_db
DB_USER=root
DB_PASSWORD=your-mysql-password-here
