# copy this to .env and put your own values in
# (.env is ignored by git so the password never ends up on github)

# any long random string works, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

DB_HOST=localhost
DB_PORT=3306
DB_NAME=housing_aggregator_db
DB_USER=root
DB_PASSWORD=your-mysql-password-here

# ---- Google Maps (optional, recommended) ----
# Turns on Google place suggestions, the map and the GPS picker.
# In Google Cloud enable "Maps JavaScript API" and "Places API (New)", then
# restrict the key to http://127.0.0.1:5000/* and http://localhost:5000/*.
# Without a key the site still suggests neighbourhoods and buildings from its
# own data and shows OpenStreetMap maps.
GOOGLE_MAPS_API_KEY=

# ---- M-Pesa payments (Safaricom Daraja, https://developer.safaricom.co.ke) ----
# Leave MPESA_CONSUMER_KEY empty to use DEMO MODE: the whole payment flow runs
# but no real request is sent and no money moves.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Safaricom must be able to reach this address. When running on your own
# computer use a tunnel such as ngrok and paste its https address here.
MPESA_CALLBACK_BASE_URL=
# Share of the monthly rent charged as the reservation deposit
MPESA_RESERVATION_PERCENT=10

# ---- reservation confirmation email (SMTP) ----
# A paid reservation sends a proof email to the renter's registered address.
# Leave SMTP_HOST empty in local demo mode; no email is sent until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15
MAIL_SENDER=
